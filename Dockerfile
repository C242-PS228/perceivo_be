FROM node:20.18.0-slim

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm install --production

COPY . .

# APP
ENV APP_ENV=production
ENV APP_HOST=0.0.0.0
ENV APP_PORT=8080
ENV APP_VERSION=1.0.0-latest

# JWT
ENV JWT_TOKEN=
ENV JWT_EXPIRES_IN=5d

# APIFY
ENV APIFY_API_KEY=

# Database
ENV DB_PORT=
ENV DB_HOST=
ENV DB_NAME=
ENV DB_USER=
ENV DB_PASS=

# MACHINE LEARNING ENDPOINT
ENV ML_FASTAPI=

EXPOSE 8080

CMD ["npm", "run", "start:prod"]

